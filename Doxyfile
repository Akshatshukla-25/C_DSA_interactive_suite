# Doxyfile for C_DSA_interactive_suite

PROJECT_NAME           = "C DSA Interactive Suite"
PROJECT_NUMBER         = "2.0.0"
PROJECT_BRIEF          = "A modular, interactive Data Structures & Algorithms library written in pure C"
OUTPUT_DIRECTORY       = doxygen_out
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

# Build options
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
CASE_SENSE_NAMES       = YES
INPUT                  = src/ help/ tui/ demos/ features/ README.md
USE_MDFILE_AS_MAINPAGE = README.md
RECURSIVE              = YES
FILE_PATTERNS          = *.c *.h *.md

# HTML output
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
GENERATE_LATEX         = NO

# Graphviz / Diagram options
HAVE_DOT               = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
